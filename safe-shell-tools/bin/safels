#!/usr/bin/env bash
#
# safels - a wrapper that adds --tree and --age options to ls.
#
# EVERYTHING other than these two options (colors, -l, -a, -h, multiple paths,
# etc.) is passed directly to the real system ls - so normal ls usage remains
# unchanged.
#
# INSTALLATION
#   cp safels ~/.local/bin/safels && chmod +x ~/.local/bin/safels
#   ln -sf ~/.local/bin/safels ~/.local/bin/ls
#   (Make sure ~/.local/bin appears before /usr/bin in PATH.)
#
# USAGE
#   ls --tree              -> lists the current directory as a tree
#   ls --tree some/path    -> lists the specified directory as a tree
#   ls --tree -a           -> includes hidden files (those beginning with .)
#   ls --age               -> shows the age of files in the current directory
#   ls --age -a some/path  -> includes hidden files for the specified directory
#   ls ...normal options... -> behaves exactly like the real ls (unchanged)

set -u

humanize_age() {
    # Convert a difference in seconds into a human-readable format.
    local diff="$1"

    if (( diff < 60 )); then
        echo "just now"
    elif (( diff < 3600 )); then
        echo "$(( diff / 60 )) minutes ago"
    elif (( diff < 86400 )); then
        echo "$(( diff / 3600 )) hours ago"
    elif (( diff < 2592000 )); then
        echo "$(( diff / 86400 )) days ago"
    elif (( diff < 31536000 )); then
        echo "$(( diff / 2592000 )) months ago"
    else
        echo "$(( diff / 31536000 )) years ago"
    fi
}

run_age() {
    local show_hidden=0 dir="."
    local a

    for a in "$@"; do
        case "$a" in
            -a|--all) show_hidden=1 ;;
            *) dir="$a" ;;
        esac
    done

    if [[ ! -d "$dir" ]]; then
        echo "safels: '$dir' is not a directory or could not be found" >&2
        return 1
    fi

    local -a entries=()
    local f base

    shopt -s nullglob
    (( show_hidden )) && shopt -s dotglob

    for f in "$dir"/*; do
        base=$(basename -- "$f")
        [[ "$base" == "." || "$base" == ".." ]] && continue
        entries+=("$f")
    done

    shopt -u nullglob dotglob

    if (( ${#entries[@]} == 0 )); then
        echo "(empty)"
        return 0
    fi

    local now mtime diff name age_str
    now=$(date +%s)

    for f in "${entries[@]}"; do
        mtime=$(stat -c '%Y' -- "$f" 2>/dev/null) || continue
        diff=$(( now - mtime ))
        (( diff < 0 )) && diff=0

        age_str=$(humanize_age "$diff")
        name=$(basename -- "$f")

        printf '%-40s %s\n' "$name" "$age_str"
    done
}

run_tree() {
    local show_hidden=0 dir="."
    local a

    for a in "$@"; do
        case "$a" in
            -a|--all) show_hidden=1 ;;
            *) dir="$a" ;;
        esac
    done

    if [[ ! -d "$dir" ]]; then
        echo "safels: '$dir' is not a directory or could not be found" >&2
        return 1
    fi

    echo "$dir"
    _tree_walk "$dir" "" "$show_hidden"
}

_tree_walk() {
    local dir="$1" prefix="$2" show_hidden="$3"
    local -a entries=()
    local f base

    shopt -s nullglob
    (( show_hidden )) && shopt -s dotglob

    for f in "$dir"/*; do
        base=$(basename -- "$f")
        [[ "$base" == "." || "$base" == ".." ]] && continue
        entries+=("$f")
    done

    shopt -u nullglob dotglob

    local count=${#entries[@]}
    local i connector new_prefix

    for (( i=0; i<count; i++ )); do
        base=$(basename -- "${entries[$i]}")

        if (( i == count - 1 )); then
            connector="└── "
            new_prefix="${prefix}    "
        else
            connector="├── "
            new_prefix="${prefix}│   "
        fi

        if [[ -d "${entries[$i]}" ]]; then
            echo "${prefix}${connector}${base}/"
            _tree_walk "${entries[$i]}" "$new_prefix" "$show_hidden"
        else
            echo "${prefix}${connector}${base}"
        fi
    done
}

# ---------- entry point ----------

mode=""
declare -a passthrough=()

for arg in "$@"; do
    case "$arg" in
        --tree) mode="tree" ;;
        --age) mode="age" ;;
        *) passthrough+=("$arg") ;;
    esac
done

case "$mode" in
    tree) run_tree "${passthrough[@]}" ;;
    age)  run_age "${passthrough[@]}" ;;
    *)    command -p ls "$@" ;;
esac
