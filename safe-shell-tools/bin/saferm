#!/usr/bin/env bash
#
# saferm - rm'yi taklit eden, 5 dakikalık geri alma penceresi olan güvenli silme aracı.
#
# NASIL ÇALIŞIR
#   "rm" ile silinen her dosya/klasör aslında $TRASH_ROOT altında kendine özel,
#   benzersiz bir alt klasöre TAŞINIR (silinmez). 5 dakika (300 sn) dolunca
#   arka planda otomatik olarak kalıcı silinir. Bu süre içinde "undelete" ile
#   dosya TAM OLARAK eski konumuna geri getirilebilir.
#
#   Çakışan isimler bir sorun oluşturmaz: her silme işlemi kendi benzersiz
#   klasörüne (zaman damgası + PID + rastgele sayı) gider, orijinal yol ayrı
#   bir metadata dosyasında saklanır.
#
# KURULUM
#   1) Bu dosyayı çalıştırılabilir yap ve kalıcı bir yere koy:
#        mkdir -p ~/.local/bin
#        cp saferm.sh ~/.local/bin/saferm
#        chmod +x ~/.local/bin/saferm
#
#   2) İki farklı isimle (rm ve undelete) çağrılabilmesi için sembolik bağlar oluştur:
#        ln -sf ~/.local/bin/saferm ~/.local/bin/rm
#        ln -sf ~/.local/bin/saferm ~/.local/bin/undelete
#
#   3) ~/.local/bin dizininin PATH içinde /usr/bin'den ÖNCE geldiğinden emin ol.
#      ~/.bashrc dosyanın EN SONUNA şunu ekle (yoksa):
#        export PATH="$HOME/.local/bin:$PATH"
#
#   4) Yeni bir terminal aç ya da: source ~/.bashrc
#
#   5) Doğrula: `which rm` çıktısı ~/.local/bin/rm göstermeli (/usr/bin/rm değil).
#
# KULLANIM
#   rm dosya.txt                  -> normal rm gibi ama gerçekte trash'e taşır
#   rm -rf klasor/                -> rm -rf ile birebir aynı sözdizimi/davranış
#   rm -i -v dosya1 dosya2         -> -i (sor), -v (ayrıntılı çıktı) desteklenir
#   rm -s file1 file2              -> TEST modu: hiçbir şeyi silmez, sadece
#                                      dosyaları, toplam sayısını ve
#                                      "Gerçek işlem YAPILMADI" mesajını basar
#   undelete                       -> çöp kutusundaki, süresi dolmamış öğeleri listeler
#   undelete <id>                  -> belirtilen kaydı eski konumuna geri getirir
#   undelete dosya.txt             -> isme/yola göre eşleşen kaydı geri getirir
#   undelete last                  -> en son silineni geri getirir
#   undelete --all                 -> çöpteki her şeyi geri getirir
#
# ÖNEMLİ NOTLAR / SINIRLAR
#   - Bu koruma yalnızca "rm" komutu düz isimle (PATH üzerinden) çağrıldığında
#     devreye girer. Bir programın doğrudan /usr/bin/rm çağırması etkilenmez
#     (bu kasıtlıdır - sistem betikleri bozulmasın diye).
#   - Script kendi içinde çöpü temizlerken GERÇEK rm/mv'yi `command -p` ile
#     çağırır (kullanıcının PATH'indeki sahte "rm"e değil, sistemin varsayılan
#     PATH'ine bakar) - böylece kendi kendini çağırıp sonsuz döngüye girmez.
#   - Çok büyük dosyaları farklı bir dosya sistemine (örn. ayrı bir disk/bölüm)
#     taşımak gerekirse `mv` içeride kopyala+sil yapar, bu da normalden yavaş
#     olabilir. Ev dizini (~/.local/share) altında kalan silmeler için bu sorun
#     olmaz çünkü aynı dosya sisteminde hızlı "rename" ile taşınır.
#   - -d (boş dizin silme) bayrağı desteklenmiyor; dizin silmek için -r/-R gerekir.

set -u

RETENTION_SECONDS=300
TRASH_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/saferm_trash"
mkdir -p "$TRASH_ROOT"

# ---------- yardımcı fonksiyonlar ----------

now_epoch() { date +%s; }

gen_id() {
    echo "$(date +%Y%m%d%H%M%S%N)_$$_${RANDOM}"
}

abs_path() {
    # Sembolik bağları çözmeden mutlak yola çevirir. rm, bir sembolik bağı
    # sildiğinde bağın kendisini siler, hedefini değil - bu davranışı
    # korumak için realpath/readlink kullanmıyoruz (onlar hedefe göre çözer).
    local p="$1"
    if [[ "$p" = /* ]]; then
        printf '%s\n' "$p"
    else
        printf '%s\n' "$PWD/$p"
    fi
}

purge_expired() {
    local dir meta deleted_at age
    shopt -s nullglob
    for dir in "$TRASH_ROOT"/*/; do
        meta="${dir}meta"
        if [[ ! -f "$meta" ]]; then
            command -p rm -rf -- "$dir"
            continue
        fi
        deleted_at=$(grep -m1 '^deleted_at=' "$meta" | cut -d= -f2)
        if [[ -z "$deleted_at" ]]; then
            command -p rm -rf -- "$dir"
            continue
        fi
        age=$(( $(now_epoch) - deleted_at ))
        if (( age >= RETENTION_SECONDS )); then
            command -p rm -rf -- "$dir"
        fi
    done
    shopt -u nullglob
}

schedule_bg_purge() {
    local entry_dir="$1"
    ( setsid bash -c "sleep $RETENTION_SECONDS; command -p rm -rf -- '$entry_dir'" \
        </dev/null >/dev/null 2>&1 & ) 2>/dev/null
    disown -a 2>/dev/null || true
}

remaining_seconds() {
    local deleted_at="$1"
    local left=$(( deleted_at + RETENTION_SECONDS - $(now_epoch) ))
    (( left < 0 )) && left=0
    echo "$left"
}

# ---------- rm davranışı ----------

do_rm() {
    local recursive=0 force=0 interactive=0 verbose=0 simulate=0
    local -a targets=()
    local end_opts=0 arg

    for arg in "$@"; do
        if (( end_opts )); then
            targets+=("$arg")
            continue
        fi
        case "$arg" in
            --) end_opts=1 ;;
            --recursive) recursive=1 ;;
            --force) force=1 ;;
            --interactive) interactive=1 ;;
            --verbose) verbose=1 ;;
            --simulate|--dry-run) simulate=1 ;;
            -) targets+=("$arg") ;;
            -*)
                local i c
                for (( i=1; i<${#arg}; i++ )); do
                    c="${arg:$i:1}"
                    case "$c" in
                        r|R) recursive=1 ;;
                        f) force=1 ;;
                        i) interactive=1 ;;
                        v) verbose=1 ;;
                        s) simulate=1 ;;
                        *)
                            echo "rm: geçersiz seçenek -- '$c'" >&2
                            return 1
                            ;;
                    esac
                done
                ;;
            *)
                targets+=("$arg")
                ;;
        esac
    done

    if (( ${#targets[@]} == 0 )); then
        if (( force )); then
            return 0
        fi
        echo "rm: eksik işlenecek dosya adı" >&2
        return 1
    fi

    # -s / --simulate / --dry-run: hiçbir şeye dokunmadan sadece önizleme göster
    if (( simulate )); then
        local t
        for t in "${targets[@]}"; do
            echo "$t"
        done
        echo "Toplam: ${#targets[@]} dosya"
        echo "Gerçek işlem YAPILMADI"
        return 0
    fi

    local exit_code=0
    local path abs entry_id entry_dir reply

    for path in "${targets[@]}"; do
        if [[ ! -e "$path" && ! -L "$path" ]]; then
            if (( ! force )); then
                echo "rm: '$path' kaldırılamıyor: Böyle bir dosya veya dizin yok" >&2
                exit_code=1
            fi
            continue
        fi

        if [[ -d "$path" && ! -L "$path" && $recursive -eq 0 ]]; then
            echo "rm: '$path' kaldırılamıyor: Dizin (bir dizini silmek için -r kullan)" >&2
            exit_code=1
            continue
        fi

        if (( interactive )); then
            read -r -p "rm: '$path' kaldırılsın mı? (e/h) " reply
            case "$reply" in
                e|E|y|Y) ;;
                *) continue ;;
            esac
        fi

        abs=$(abs_path "$path")
        entry_id=$(gen_id)
        entry_dir="$TRASH_ROOT/$entry_id"
        mkdir -p "$entry_dir"

        if ! command -p mv -- "$path" "$entry_dir/payload" 2>/tmp/.saferm_err; then
            echo "rm: '$path' taşınamadı: $(cat /tmp/.saferm_err 2>/dev/null)" >&2
            command -p rm -rf -- "$entry_dir"
            exit_code=1
            continue
        fi

        {
            printf 'original_path=%s\n' "$abs"
            printf 'deleted_at=%s\n' "$(now_epoch)"
        } > "$entry_dir/meta"

        schedule_bg_purge "$entry_dir"

        if (( verbose )); then
            echo "kaldırıldı: '$path'  (geri almak için: undelete $entry_id  |  pencere: 5 dk)"
        fi
    done

    return $exit_code
}

# ---------- undelete davranışı ----------

list_trash() {
    purge_expired
    local dir meta original_path deleted_at left found=0
    shopt -s nullglob
    printf '%-24s %-8s %s\n' "ID" "KALAN" "ORİJİNAL KONUM"
    for dir in "$TRASH_ROOT"/*/; do
        meta="${dir}meta"
        [[ -f "$meta" ]] || continue
        original_path=$(grep -m1 '^original_path=' "$meta" | cut -d= -f2-)
        deleted_at=$(grep -m1 '^deleted_at=' "$meta" | cut -d= -f2)
        left=$(remaining_seconds "$deleted_at")
        printf '%-24s %-8s %s\n' "$(basename "$dir")" "${left}sn" "$original_path"
        found=1
    done
    shopt -u nullglob
    (( found )) || echo "(çöp kutusu boş)"
}

restore_entry_dir() {
    local entry_dir="$1"
    local meta="${entry_dir}meta"
    if [[ ! -f "$meta" ]]; then
        echo "undelete: geçersiz kayıt: $entry_dir" >&2
        return 1
    fi

    local original_path deleted_at left target
    original_path=$(grep -m1 '^original_path=' "$meta" | cut -d= -f2-)
    deleted_at=$(grep -m1 '^deleted_at=' "$meta" | cut -d= -f2)
    left=$(remaining_seconds "$deleted_at")

    if (( left <= 0 )); then
        echo "undelete: '$original_path' için geri alma süresi dolmuş" >&2
        command -p rm -rf -- "$entry_dir"
        return 1
    fi

    target="$original_path"
    if [[ -e "$target" || -L "$target" ]]; then
        target="${original_path}.restored-$(date +%s)"
        echo "undelete: '$original_path' zaten mevcut, bunun yerine '$target' olarak geri getiriliyor" >&2
    fi

    mkdir -p "$(dirname "$target")"
    if command -p mv -- "${entry_dir}payload" "$target"; then
        command -p rm -rf -- "$entry_dir"
        echo "geri getirildi: '$target'"
        return 0
    else
        echo "undelete: '$target' konumuna geri getirilemedi" >&2
        return 1
    fi
}

do_undelete() {
    purge_expired

    if (( $# == 0 )); then
        list_trash
        return 0
    fi

    case "$1" in
        list|-l)
            list_trash
            return 0
            ;;
        --all)
            local dir any=0
            shopt -s nullglob
            for dir in "$TRASH_ROOT"/*/; do
                restore_entry_dir "$dir"
                any=1
            done
            shopt -u nullglob
            (( any )) || echo "(çöp kutusu boş)"
            return 0
            ;;
        last)
            # Kayıt klasörü adları sabit genişlikli zaman damgasıyla başlar
            # (YYYYAAGGSSDDNN + nanosaniye), bu yüzden alfabetik sıralamadaki
            # SON öğe her zaman kronolojik olarak da en son silinendir.
            # (deleted_at alanı saniye hassasiyetinde olduğundan, aynı saniye
            # içinde birden fazla silme olduğunda tek başına yetersiz kalır.)
            local newest="" dir meta
            shopt -s nullglob
            for dir in "$TRASH_ROOT"/*/; do
                meta="${dir}meta"
                [[ -f "$meta" ]] || continue
                newest="$dir"
            done
            shopt -u nullglob
            if [[ -z "$newest" ]]; then
                echo "(çöp kutusu boş)"
                return 1
            fi
            restore_entry_dir "$newest"
            return $?
            ;;
        *)
            local exit_code=0 id entry_dir found d meta original_path
            for id in "$@"; do
                entry_dir="$TRASH_ROOT/$id/"
                if [[ -d "$entry_dir" ]]; then
                    restore_entry_dir "$entry_dir" || exit_code=1
                    continue
                fi
                found=0
                shopt -s nullglob
                for d in "$TRASH_ROOT"/*/; do
                    meta="${d}meta"
                    [[ -f "$meta" ]] || continue
                    original_path=$(grep -m1 '^original_path=' "$meta" | cut -d= -f2-)
                    if [[ "$original_path" == "$id" || "$(basename "$original_path")" == "$id" ]]; then
                        restore_entry_dir "$d" || exit_code=1
                        found=1
                    fi
                done
                shopt -u nullglob
                if (( ! found )); then
                    echo "undelete: '$id' çöp kutusunda bulunamadı" >&2
                    exit_code=1
                fi
            done
            return $exit_code
            ;;
    esac
}

# ---------- giriş noktası ----------

prog="$(basename -- "$0")"
purge_expired

case "$prog" in
    undelete)
        do_undelete "$@"
        exit $?
        ;;
    *)
        do_rm "$@"
        exit $?
        ;;
esac
